# ─── Supabase (kept during the legacy-APK compatibility window) ───
# Dashboard → Project Settings → API Keys
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Legacy only: old APKs still read this project. The web app and 1.5.63+
# clients use LABU_CLOUD_API below instead.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only. Never paste this into index.html and never commit it.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Optional: Management API token (Dashboard → Account → Access Tokens), used by
# `node scripts/export_supabase.mjs`. Never ships to the app.
PAT=

# ─── Cloudflare / Wrangler ───
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Public Worker origin baked into index.html by scripts/set_cloud_config.mjs.
LABU_CLOUD_API=https://api.labu.lengkhawm.online

# ─── Better Auth Worker ───
# Put local-only values in workers/api/.dev.vars, not here.
BETTER_AUTH_SECRET=
SETUP_TOKEN=
ADMIN_EMAILS=you@example.com

# Optional Google sign-in. GOOGLE_CLIENT_IDS is a comma-separated audience list
# containing the web OAuth client and the Android client.
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=
