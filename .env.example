# Supabase project (Dashboard → Project Settings → API Keys)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Publishable / anon key — a public identifier, safe to ship in the app.
# `node scripts/set_cloud_config.mjs` bakes this into index.html.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only. Never paste this into index.html and never commit it.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Optional: Management API token (Dashboard → Account → Access Tokens), used only
# for checking/operating the project from a terminal. Never ships to the app.
PAT=
