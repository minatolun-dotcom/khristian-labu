{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "labu-api-staging",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "labu-staging",
      "database_id": "75c4dc65-e770-42d6-8e29-b643907f99f6",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "staging",
    "BETTER_AUTH_URL": "https://api-staging.labu.lengkhawm.online",
    "CORS_ORIGINS": "https://labu.lengkhawm.online,https://staging.labu.lengkhawm.online,https://localhost,capacitor://localhost,http://localhost:8791,http://127.0.0.1:8791",
    "ADMIN_EMAILS": "minatolun@gmail.com"
  },
  "routes": [
    {
      "pattern": "api-staging.labu.lengkhawm.online",
      "custom_domain": true
    }
  ]
}
